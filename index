  <!-- Czcionki Google: Inter oraz JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&display=swap" rel="stylesheet" />

  <style>
    /* ==================== ZMIENNE I MOTYWY ==================== */
    :root {
      --bg-page: #f8fafc;
      --bg-card: #ffffff;
      --bg-subtle: #f1f5f9;
      --bg-hover: #f8fafc;
      --bg-header: rgba(255, 255, 255, 0.88);
      --border: #e2e8f0;
      --border-strong: #cbd5e1;
      --text-main: #0f172a;
      --text-secondary: #475569;
      --text-muted: #64748b;
      --accent-indigo: #4f46e5;
      --accent-violet: #7c3aed;
      --accent-cyan: #06b6d4;
      --accent-emerald: #10b981;
      --accent-amber: #f59e0b;
      --accent-rose: #e11d48;
      --accent-soft: #eef2ff;
      --accent-soft-text: #4338ca;
      --emerald-soft: #ecfdf5;
      --emerald-soft-text: #047857;
      --emerald-border: #a7f3d0;
      --amber-soft: #fffbeb;
      --amber-soft-text: #b45309;
      --amber-border: #fde68a;
      --rose-soft: #fff1f2;
      --rose-soft-text: #be123c;
      --rose-border: #fecdd3;
      --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
      --shadow-md: 0 8px 24px -6px rgba(15, 23, 42, 0.08);
      --shadow-lg: 0 20px 45px -12px rgba(15, 23, 42, 0.22);
      --radius-sm: 10px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-xl: 26px;
      --font-sans: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
    }

    html.dark {
      --bg-page: #020617;
      --bg-card: #0f172a;
      --bg-subtle: #1e293b;
      --bg-hover: #162033;
      --bg-header: rgba(15, 23, 42, 0.88);
      --border: #1e293b;
      --border-strong: #334155;
      --text-main: #f8fafc;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --accent-soft: rgba(99, 102, 241, 0.16);
      --accent-soft-text: #a5b4fc;
      --emerald-soft: rgba(16, 185, 129, 0.14);
      --emerald-soft-text: #6ee7b7;
      --emerald-border: rgba(16, 185, 129, 0.32);
      --amber-soft: rgba(245, 158, 11, 0.14);
      --amber-soft-text: #fcd34d;
      --amber-border: rgba(245, 158, 11, 0.32);
      --rose-soft: rgba(225, 29, 72, 0.15);
      --rose-soft-text: #fda4af;
      --rose-border: rgba(225, 29, 72, 0.35);
      --shadow-sm: 0 1px 2px rgba(0, 0, 0, 0.25);
      --shadow-md: 0 10px 28px -6px rgba(0, 0, 0, 0.45);
      --shadow-lg: 0 24px 55px -12px rgba(0, 0, 0, 0.65);
    }

    /* ==================== RESET I BAZA ==================== */
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      background-color: var(--bg-page);
      color: var(--text-main);
      font-family: var(--font-sans);
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    button, input, select {
      font-family: inherit;
    }

    button {
      cursor: pointer;
    }

    button:disabled {
      opacity: 0.55;
      cursor: not-allowed;
    }

    ::selection {
      background: var(--accent-violet);
      color: #ffffff;
    }

    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(148, 163, 184, 0.45);
      border-radius: 999px;
    }

    .container {
      width: 100%;
      max-width: 1152px;
      margin: 0 auto;
      padding: 0 16px;
    }

    @media (min-width: 640px) {
      .container { padding: 0 24px; }
    }

    .hidden { display: none !important; }

    /* ==================== NAGŁÓWEK ==================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 30;
      background: var(--bg-header);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border);
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      min-height: 64px;
      padding: 8px 0;
      flex-wrap: wrap;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
      color: inherit;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 12px;
      background: linear-gradient(135deg, var(--accent-indigo), var(--accent-violet) 55%, var(--accent-cyan));
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 8px 18px -4px rgba(79, 70, 229, 0.4);
      transition: transform 0.2s ease;
      flex-shrink: 0;
    }

    .brand:hover .brand-icon {
      transform: scale(1.05);
    }

    .brand-text {
      display: flex;
      flex-direction: column;
    }

    .brand-name {
      font-size: 1.15rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 1.1;
    }

    .brand-name span {
      background: linear-gradient(90deg, var(--accent-indigo), var(--accent-cyan));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .brand-sub {
      font-size: 0.7rem;
      color: var(--text-muted);
      margin-top: 2px;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-left: auto;
    }

    .mode-switch {
      display: inline-flex;
      align-items: center;
      padding: 4px;
      border-radius: 12px;
      background: var(--bg-subtle);
      border: 1px solid var(--border);
    }

    .mode-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 6px 12px;
      border: 0;
      border-radius: 9px;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.75rem;
      font-weight: 600;
      transition: all 0.18s ease;
    }

    .mode-btn.active-live {
      background: var(--bg-card);
      color: var(--emerald-soft-text);
      box-shadow: var(--shadow-sm);
    }

    .mode-btn.active-demo {
      background: var(--bg-card);
      color: var(--amber-soft-text);
      box-shadow: var(--shadow-sm);
    }

    .pulse-dot {
      position: relative;
      display: inline-flex;
      width: 8px;
      height: 8px;
      flex-shrink: 0;
    }

    .pulse-dot::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 999px;
      background: var(--accent-emerald);
      opacity: 0.75;
      animation: ping 1.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    .pulse-dot::after {
      content: '';
      position: relative;
      width: 8px;
      height: 8px;
      border-radius: 999px;
      background: var(--accent-emerald);
    }

    .icon-btn {
      width: 38px;
      height: 38px;
      border-radius: 11px;
      border: 1px solid var(--border);
      background: var(--bg-subtle);
      color: var(--text-secondary);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      transition: background 0.18s ease, color 0.18s ease;
    }

    .icon-btn:hover {
      background: var(--border);
      color: var(--text-main);
    }

    /* Pasek postępu auto-odświeżania */
    .progress-track {
      height: 3px;
      width: 100%;
      background: var(--border);
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      width: 100%;
      background: linear-gradient(90deg, var(--accent-indigo), var(--accent-violet), var(--accent-cyan));
      transition: width 1s linear;
    }

    /* ==================== GŁÓWNA TREŚĆ ==================== */
    main {
      flex: 1;
      padding: 24px 0 36px;
    }

    .stack {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    .card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-sm);
    }

    /* ==================== HERO: PANEL ADRESU ==================== */
    .hero-card {
      position: relative;
      overflow: hidden;
      padding: 24px 20px;
    }

    @media (min-width: 640px) {
      .hero-card { padding: 34px 32px; }
    }

    .hero-glow-1, .hero-glow-2 {
      position: absolute;
      width: 280px;
      height: 280px;
      border-radius: 999px;
      filter: blur(70px);
      pointer-events: none;
      opacity: 0.14;
    }

    .hero-glow-1 {
      top: -110px;
      right: -90px;
      background: var(--accent-violet);
    }

    .hero-glow-2 {
      bottom: -110px;
      left: -90px;
      background: var(--accent-cyan);
    }

    .hero-content {
      position: relative;
      z-index: 1;
      max-width: 760px;
      margin: 0 auto;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 14px;
      border-radius: 999px;
      font-size: 0.78rem;
      font-weight: 600;
      border: 1px solid var(--emerald-border);
      background: var(--emerald-soft);
      color: var(--emerald-soft-text);
    }

    .status-pill.is-demo {
      border-color: var(--amber-border);
      background: var(--amber-soft);
      color: var(--amber-soft-text);
    }

    .status-pill.is-error {
      border-color: var(--rose-border);
      background: var(--rose-soft);
      color: var(--rose-soft-text);
    }

    .hero-title {
      margin: 0;
      font-size: 1.55rem;
      font-weight: 800;
      letter-spacing: -0.025em;
    }

    @media (min-width: 640px) {
      .hero-title { font-size: 1.85rem; }
    }

    .hero-subtitle {
      margin: 6px 0 0;
      font-size: 0.9rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Baner błędu sieciowego */
    .error-banner {
      width: 100%;
      padding: 12px 16px;
      border-radius: var(--radius-md);
      background: var(--rose-soft);
      border: 1px solid var(--rose-border);
      color: var(--rose-soft-text);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      text-align: left;
      font-size: 0.84rem;
    }

    .error-banner-actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    /* Pole adresu e-mail */
    .email-bar {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 8px;
      border-radius: 18px;
      background: var(--bg-subtle);
      border: 1px solid var(--border);
    }

    @media (min-width: 640px) {
      .email-bar {
        flex-direction: row;
        align-items: center;
      }
    }

    .email-input-wrap {
      flex: 1;
      display: flex;
      align-items: center;
      min-width: 0;
      padding-left: 10px;
    }

    .email-input-icon {
      color: var(--accent-violet);
      flex-shrink: 0;
    }

    .email-input {
      width: 100%;
      border: 0;
      background: transparent;
      padding: 10px 12px;
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-main);
      outline: none;
    }

    @media (min-width: 640px) {
      .email-input { font-size: 1.12rem; }
    }

    /* Przyciski */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-secondary);
      font-size: 0.86rem;
      font-weight: 600;
      transition: all 0.16s ease;
      white-space: nowrap;
    }

    .btn:hover:not(:disabled) {
      background: var(--bg-subtle);
      color: var(--text-main);
      border-color: var(--border-strong);
    }

    .btn-primary {
      border: 0;
      padding: 12px 24px;
      background: linear-gradient(135deg, var(--accent-indigo), var(--accent-violet));
      color: #ffffff;
      box-shadow: 0 8px 20px -6px rgba(79, 70, 229, 0.45);
    }

    .btn-primary:hover:not(:disabled) {
      background: linear-gradient(135deg, #4338ca, #6d28d9);
      color: #ffffff;
      transform: translateY(-1px);
    }

    .btn-emerald {
      border: 0;
      background: var(--accent-emerald);
      color: #ffffff;
      box-shadow: 0 6px 16px -6px rgba(16, 185, 129, 0.45);
    }

    .btn-emerald:hover:not(:disabled) {
      background: #059669;
      color: #ffffff;
    }

    .btn-danger {
      color: var(--accent-rose);
    }

    .btn-danger:hover:not(:disabled) {
      background: var(--rose-soft);
      border-color: var(--rose-border);
      color: var(--rose-soft-text);
    }

    .btn-sm {
      padding: 6px 12px;
      font-size: 0.78rem;
      border-radius: 9px;
    }

    .action-row {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }

    .hero-meta {
      width: 100%;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .session-box {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .mono {
      font-family: var(--font-mono);
    }

    .code-tag {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      padding: 2px 6px;
      border-radius: 6px;
      background: var(--bg-subtle);
      color: var(--accent-violet);
    }

    /* ==================== SKRZYNKA ODBIORCZA (SPLIT-VIEW) ==================== */
    .inbox-card {
      overflow: hidden;
    }

    .inbox-toolbar {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-hover);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .inbox-heading {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .inbox-heading h2 {
      margin: 0;
      font-size: 1.05rem;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      border-radius: 999px;
      font-size: 0.75rem;
      font-weight: 600;
      background: var(--accent-soft);
      color: var(--accent-soft-text);
    }

    .badge-muted {
      background: var(--bg-subtle);
      color: var(--text-muted);
    }

    .inbox-controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
      flex: 1;
      justify-content: flex-end;
    }

    .search-wrap {
      position: relative;
      width: 100%;
      max-width: 280px;
    }

    .search-wrap svg {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 8px 12px 8px 34px;
      border-radius: 11px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-main);
      font-size: 0.85rem;
      outline: none;
    }

    .search-input:focus {
      border-color: var(--accent-violet);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.15);
    }

    .inbox-grid {
      display: grid;
      grid-template-columns: 1fr;
      min-height: 520px;
    }

    @media (min-width: 1024px) {
      .inbox-grid {
        grid-template-columns: 5fr 7fr;
      }
    }

    .msg-list-pane {
      border-bottom: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      max-height: 640px;
      overflow-y: auto;
    }

    @media (min-width: 1024px) {
      .msg-list-pane {
        border-bottom: 0;
        border-right: 1px solid var(--border);
      }
    }

    .msg-detail-pane {
      display: none;
      flex-direction: column;
      background: var(--bg-hover);
      min-height: 520px;
    }

    @media (min-width: 1024px) {
      .msg-detail-pane {
        display: flex;
      }
    }

    .msg-list-pane.mobile-hidden {
      display: none;
    }

    @media (min-width: 1024px) {
      .msg-list-pane.mobile-hidden {
        display: flex;
      }
    }

    .msg-detail-pane.mobile-visible {
      display: flex;
    }

    .empty-state {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 40px 24px;
      text-align: center;
      gap: 12px;
      color: var(--text-muted);
    }

    .empty-icon {
      width: 56px;
      height: 56px;
      border-radius: 16px;
      background: var(--bg-subtle);
      color: var(--accent-violet);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .empty-state p {
      margin: 0;
      font-size: 0.85rem;
      max-width: 300px;
      line-height: 1.5;
    }

    .empty-state strong {
      color: var(--text-main);
      font-size: 0.92rem;
    }

    /* Element listy wiadomości */
    .msg-item {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 14px 16px;
      border-bottom: 1px solid var(--border);
      cursor: pointer;
      transition: background 0.15s ease;
    }

    .msg-item:hover {
      background: var(--bg-hover);
    }

    .msg-item.selected {
      background: var(--accent-soft);
    }

    .msg-item.selected::before {
      content: '';
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 4px;
      background: linear-gradient(180deg, var(--accent-indigo), var(--accent-cyan));
    }

    .avatar {
      position: relative;
      width: 40px;
      height: 40px;
      border-radius: 12px;
      color: #ffffff;
      font-weight: 700;
      font-size: 0.78rem;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .unread-dot {
      position: absolute;
      top: -3px;
      right: -3px;
      width: 11px;
      height: 11px;
      border-radius: 999px;
      background: var(--accent-cyan);
      border: 2px solid var(--bg-card);
    }

    .msg-meta {
      flex: 1;
      min-width: 0;
    }

    .msg-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .msg-sender {
      font-size: 0.88rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .msg-sender.unread {
      font-weight: 700;
      color: var(--text-main);
    }

    .msg-time {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      color: var(--text-muted);
      flex-shrink: 0;
    }

    .msg-subject {
      margin: 3px 0 0;
      font-size: 0.84rem;
      color: var(--text-secondary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .msg-subject.unread {
      font-weight: 600;
      color: var(--text-main);
    }

    .msg-preview-row {
      display: flex;
      align-items: center;
      gap: 6px;
      margin-top: 4px;
    }

    .msg-excerpt {
      margin: 0;
      font-size: 0.76rem;
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .otp-chip {
      padding: 1px 6px;
      border-radius: 5px;
      background: var(--emerald-soft);
      color: var(--emerald-soft-text);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      font-weight: 700;
      flex-shrink: 0;
    }

    .msg-del-btn {
      padding: 6px;
      border: 0;
      border-radius: 8px;
      background: transparent;
      color: var(--text-muted);
      align-self: center;
      transition: all 0.15s ease;
    }

    .msg-del-btn:hover {
      background: var(--rose-soft);
      color: var(--accent-rose);
    }

    /* Podgląd wiadomości */
    .detail-toolbar {
      padding: 12px 18px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-card);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .back-mobile-btn {
      display: inline-flex;
    }

    @media (min-width: 1024px) {
      .back-mobile-btn { display: none; }
    }

    .view-toggle {
      display: inline-flex;
      padding: 3px;
      border-radius: 10px;
      background: var(--bg-subtle);
      border: 1px solid var(--border);
    }

    .view-toggle button {
      border: 0;
      background: transparent;
      color: var(--text-muted);
      padding: 4px 10px;
      border-radius: 7px;
      font-size: 0.76rem;
      font-weight: 600;
    }

    .view-toggle button.active {
      background: var(--bg-card);
      color: var(--accent-violet);
      box-shadow: var(--shadow-sm);
    }

    .otp-banner {
      padding: 12px 18px;
      background: linear-gradient(90deg, rgba(16, 185, 129, 0.13), rgba(6, 182, 212, 0.12));
      border-bottom: 1px solid var(--emerald-border);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .otp-info {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .otp-icon {
      width: 34px;
      height: 34px;
      border-radius: 10px;
      background: var(--accent-emerald);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .otp-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-weight: 700;
      color: var(--emerald-soft-text);
    }

    .otp-code {
      font-family: var(--font-mono);
      font-size: 1.2rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      color: var(--text-main);
    }

    .detail-header {
      padding: 16px 20px;
      border-bottom: 1px solid var(--border);
      background: var(--bg-card);
    }

    .detail-subject {
      margin: 0 0 12px;
      font-size: 1.08rem;
      font-weight: 700;
      line-height: 1.35;
    }

    .detail-sender-row {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .detail-body {
      flex: 1;
      display: flex;
      flex-direction: column;
      background: var(--bg-card);
      min-height: 340px;
    }

    .email-iframe {
      width: 100%;
      flex: 1;
      min-height: 380px;
      border: 0;
      background: #ffffff;
    }

    .email-text-body {
      margin: 0;
      padding: 20px;
      font-family: var(--font-sans);
      font-size: 0.9rem;
      line-height: 1.65;
      color: var(--text-secondary);
      white-space: pre-wrap;
      word-break: break-word;
      overflow-y: auto;
      flex: 1;
    }

    /* ==================== KARTY KORZYŚCI (3 KARTY) ==================== */
    .benefits-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px;
    }

    @media (min-width: 768px) {
      .benefits-grid { grid-template-columns: repeat(3, 1fr); }
    }

    .benefit-card {
      padding: 22px;
      border-radius: var(--radius-lg);
      background: var(--bg-card);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }

    .benefit-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 14px;
    }

    .benefit-card h3 {
      margin: 0 0 8px;
      font-size: 0.98rem;
      font-weight: 700;
    }

    .benefit-card p {
      margin: 0;
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    /* ==================== FAQ (AKORDEON) ==================== */
    .faq-card {
      padding: 24px 20px;
    }

    @media (min-width: 640px) {
      .faq-card { padding: 30px 32px; }
    }

    .faq-inner {
      max-width: 780px;
      margin: 0 auto;
    }

    .faq-inner h2 {
      margin: 0 0 18px;
      font-size: 1.2rem;
      font-weight: 700;
    }

    .faq-item {
      border-bottom: 1px solid var(--border);
      padding: 14px 0;
    }

    .faq-item:last-child {
      border-bottom: 0;
    }

    .faq-trigger {
      width: 100%;
      border: 0;
      background: transparent;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      text-align: left;
      font-size: 0.94rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .faq-trigger:hover {
      color: var(--accent-violet);
    }

    .faq-chevron {
      flex-shrink: 0;
      color: var(--text-muted);
      transition: transform 0.2s ease;
    }

    .faq-trigger[aria-expanded="true"] .faq-chevron {
      transform: rotate(180deg);
    }

    .faq-content {
      margin-top: 10px;
      font-size: 0.86rem;
      color: var(--text-muted);
      line-height: 1.6;
    }

    /* ==================== STOPKA ==================== */
    .site-footer {
      border-top: 1px solid var(--border);
      background: var(--bg-card);
      padding: 20px 0;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
    }

    /* ==================== MODALE ==================== */
    .modal-backdrop {
      position: fixed;
      inset: 0;
      z-index: 50;
      background: rgba(2, 6, 23, 0.62);
      backdrop-filter: blur(4px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      animation: fadeIn 0.2s ease-out;
    }

    .modal-box {
      width: 100%;
      max-width: 440px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      box-shadow: var(--shadow-lg);
      padding: 24px;
      animation: slideUp 0.22s ease-out;
    }

    .modal-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
    }

    .modal-header h3 {
      margin: 0;
      font-size: 1.08rem;
      font-weight: 700;
    }

    .form-group {
      margin-bottom: 16px;
    }

    .form-label {
      display: block;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .form-row {
      display: flex;
      gap: 8px;
    }

    .form-control {
      width: 100%;
      padding: 10px 12px;
      border-radius: 11px;
      border: 1px solid var(--border);
      background: var(--bg-subtle);
      color: var(--text-main);
      font-family: var(--font-mono);
      font-size: 0.88rem;
      outline: none;
    }

    .form-control:focus {
      border-color: var(--accent-violet);
      box-shadow: 0 0 0 3px rgba(124, 58, 237, 0.16);
    }

    .modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 8px;
      margin-top: 20px;
    }

    .qr-box {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 14px;
      border-radius: 16px;
      background: #ffffff;
      border: 1px solid var(--border);
      margin: 10px auto;
    }

    .qr-box img {
      width: 192px;
      height: 192px;
      display: block;
      border-radius: 8px;
    }

    .qr-email-pill {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      font-weight: 600;
      color: var(--accent-soft-text);
      background: var(--accent-soft);
      padding: 8px 12px;
      border-radius: 10px;
      word-break: break-all;
      margin: 12px 0 18px;
    }

    /* ==================== POWIADOMIENIA TOAST ==================== */
    .toast-container {
      position: fixed;
      bottom: 20px;
      right: 20px;
      left: 20px;
      z-index: 60;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 8px;
      pointer-events: none;
    }

    @media (max-width: 639px) {
      .toast-container { align-items: center; }
    }

    .toast {
      pointer-events: auto;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      padding: 12px 16px;
      border-radius: 14px;
      font-size: 0.84rem;
      font-weight: 600;
      color: #ffffff;
      max-width: 380px;
      box-shadow: var(--shadow-md);
      animation: slideUp 0.22s ease-out;
    }

    .toast-info { background: #1e293b; }
    .toast-success { background: #059669; }
    .toast-warning { background: #d97706; }
    .toast-error { background: #e11d48; }

    /* ==================== ANIMACJE ==================== */
    @keyframes ping {
      75%, 100% { transform: scale(2.1); opacity: 0; }
    }
    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes spinOnce {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .spin-once {
      animation: spinOnce 0.65s ease-in-out;
    }
    .spin-loop {
      animation: spinOnce 0.9s linear infinite;
    }
  </style>
</head>
<body>

  <!-- ==================== NAGŁÓWEK ==================== -->
  <header class="site-header">
    <div class="container header-inner">
      <a href="#" class="brand" aria-label="ZnikMail — strona główna">
        <div class="brand-icon">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5h11A2.5 2.5 0 0 1 20 7.5v7A2.5 2.5 0 0 1 17.5 17H9" />
