          </svg>
        </button>
      </div>
    </div>

    <!-- Pasek postępu auto-odświeżania (co 7 sekund) -->
    <div class="progress-track">
      <div id="refreshProgressBar" class="progress-fill"></div>
    </div>
  </header>

  <!-- ==================== GŁÓWNA ZAWARTOŚĆ ==================== -->
  <main>
    <div class="container stack">

      <!-- ===== KARTA GŁÓWNA: ZARZĄDZANIE ADRESEM ===== -->
      <section class="card hero-card">
        <div class="hero-glow-1"></div>
        <div class="hero-glow-2"></div>

        <div class="hero-content">
          <div id="statusPill" class="status-pill">
            <span class="pulse-dot"></span>
            <span id="statusPillText">Łączenie z serwerem pocztowym...</span>
          </div>

          <div>
            <h1 class="hero-title">Twój tymczasowy adres e-mail</h1>
            <p class="hero-subtitle">
              Odbieraj prawdziwe wiadomości i kody weryfikacyjne bez podawania prywatnej skrzynki. Sesja zapisuje się automatycznie.
            </p>
          </div>

          <!-- Baner błędu sieciowego (ukryty, gdy połączenie działa) -->
          <div id="networkErrorBanner" class="error-banner hidden" role="alert">
            <div>
              <strong>Błąd połączenia z API:</strong>
              <span id="networkErrorText"></span>
            </div>
            <div class="error-banner-actions">
              <button id="retryLiveBtn" type="button" class="btn btn-sm">Spróbuj ponownie</button>
              <button id="switchToDemoFromErrorBtn" type="button" class="btn btn-sm btn-emerald">Przełącz na tryb Demo</button>
            </div>
          </div>

          <!-- Pole adresu + Kopiuj -->
          <div class="email-bar">
            <div class="email-input-wrap">
              <svg class="email-input-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207" />
              </svg>
              <input id="emailInput" class="email-input" type="text" readonly value="Generowanie adresu..." aria-label="Twój tymczasowy adres e-mail" />
            </div>
            <button id="copyEmailBtn" type="button" class="btn btn-primary">
              <svg id="copyBtnIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copyBtnText">Kopiuj</span>
            </button>
          </div>

          <!-- Przyciski akcji -->
          <div class="action-row">
            <button id="refreshBtn" type="button" class="btn">
              <svg id="refreshIcon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-violet)">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
              <span>Odśwież</span>
            </button>

            <button id="changeAddressBtn" type="button" class="btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-cyan)">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
              </svg>
              <span>Zmień / Własny adres</span>
            </button>

            <button id="newRandomBtn" type="button" class="btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: var(--accent-indigo)">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
              </svg>
              <span>Nowy losowy</span>
            </button>

            <button id="qrCodeBtn" type="button" class="btn">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z" />
