<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ZnikMail — Tymczasowa Poczta E-mail Na Żywo</title>

  <!-- Favicon w SVG (brak błędu 404 favicon.ico) -->
