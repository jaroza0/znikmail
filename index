            <span id="unreadBadge" class="badge badge-muted">0 wiadomości</span>
          </div>

          <div class="inbox-controls">
            <div class="search-wrap">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input id="searchInput" class="search-input" type="text" placeholder="Szukaj nadawcy, tematu..." />
            </div>

            <button id="sendDemoEmailBtn" type="button" class="btn btn-emerald hidden">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
              </svg>
              <span>Wyślij testowy e-mail</span>
            </button>
          </div>
        </div>

        <div class="inbox-grid">
          <div id="messageListPane" class="msg-list-pane"></div>
          <div id="messageDetailPane" class="msg-detail-pane"></div>
        </div>
      </section>

      <!-- ===== SEKCJA KORZYŚCI (3 KARTY) ===== -->
