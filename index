            <path d="M3 13h3" stroke-opacity="0.7" />
            <path d="M2 16.5h4.5" stroke-opacity="0.5" />
            <path d="M18.5 2.5l.6 1.4 1.4.6-1.4.6-.6 1.4-.6-1.4-1.4-.6 1.4-.6.6-1.4z" fill="currentColor" stroke="none" />
          </svg>
        </div>
        <div class="brand-text">
          <span class="brand-name">Znik<span>Mail</span></span>
          <span class="brand-sub">Jednorazowa poczta na żywo</span>
        </div>
      </a>

      <div class="header-actions">
        <div class="mode-switch" role="group" aria-label="Tryb pracy skrzynki">
          <button id="modeLiveBtn" type="button" class="mode-btn active-live">
            <span class="pulse-dot"></span>
            <span>Na Żywo</span>
          </button>
          <button id="modeDemoBtn" type="button" class="mode-btn">
            <span>Demo</span>
          </button>
        </div>

        <button id="themeToggleBtn" type="button" class="icon-btn" aria-label="Przełącz motyw jasny lub ciemny" title="Przełącz motyw">
          <svg id="iconSun" class="hidden" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg id="iconMoon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
