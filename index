      const dom = {
        modeLiveBtn: document.getElementById('modeLiveBtn'),
        modeDemoBtn: document.getElementById('modeDemoBtn'),
        themeToggleBtn: document.getElementById('themeToggleBtn'),
        iconSun: document.getElementById('iconSun'),
        iconMoon: document.getElementById('iconMoon'),
        refreshProgressBar: document.getElementById('refreshProgressBar'),
        statusPill: document.getElementById('statusPill'),
        statusPillText: document.getElementById('statusPillText'),
        networkErrorBanner: document.getElementById('networkErrorBanner'),
        networkErrorText: document.getElementById('networkErrorText'),
        retryLiveBtn: document.getElementById('retryLiveBtn'),
        switchToDemoFromErrorBtn: document.getElementById('switchToDemoFromErrorBtn'),
        emailInput: document.getElementById('emailInput'),
        copyEmailBtn: document.getElementById('copyEmailBtn'),
        copyBtnText: document.getElementById('copyBtnText'),
        copyBtnIcon: document.getElementById('copyBtnIcon'),
        refreshBtn: document.getElementById('refreshBtn'),
        refreshIcon: document.getElementById('refreshIcon'),
        changeAddressBtn: document.getElementById('changeAddressBtn'),
        newRandomBtn: document.getElementById('newRandomBtn'),
        qrCodeBtn: document.getElementById('qrCodeBtn'),
        deleteMailboxBtn: document.getElementById('deleteMailboxBtn'),
        sessionTimer: document.getElementById('sessionTimer'),
        resetSessionTimerBtn: document.getElementById('resetSessionTimerBtn'),
        unreadBadge: document.getElementById('unreadBadge'),
        searchInput: document.getElementById('searchInput'),
        sendDemoEmailBtn: document.getElementById('sendDemoEmailBtn'),
        messageListPane: document.getElementById('messageListPane'),
