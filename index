        changeAddressModal: document.getElementById('changeAddressModal'),
        changeAddressForm: document.getElementById('changeAddressForm'),
        customUsernameInput: document.getElementById('customUsernameInput'),
        domainSelect: document.getElementById('domainSelect'),
        randomizeUsernameBtn: document.getElementById('randomizeUsernameBtn'),
        qrModal: document.getElementById('qrModal'),
        qrImage: document.getElementById('qrImage'),
        qrEmailLabel: document.getElementById('qrEmailLabel'),
        toastContainer: document.getElementById('toastContainer'),
        currentYear: document.getElementById('currentYear'),
      };

      // ==========================================
      // 3. FUNKCJE POMOCNICZE
      // ==========================================
      function escapeHtml(str) {
        return String(str ?? '')
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#39;');
      }

      function getDisplayEmail() {
        if (!state.session || !state.session.login) return '';
        return `${state.session.login}@${state.session.domain || LIVE_DOMAIN}`;
      }

      function generateRandomLogin() {
        const wordsA = ['znik', 'iskra', 'chmura', 'blysk', 'nova', 'solar', 'velo', 'mira', 'zen', 'lumen', 'echo', 'komet'];
        const wordsB = ['mail', 'box', 'post', 'drop', 'net', 'hub', 'key', 'air', 'sky', 'pro'];
        const p1 = wordsA[Math.floor(Math.random() * wordsA.length)];
        const p2 = wordsB[Math.floor(Math.random() * wordsB.length)];
        const num = Math.floor(100 + Math.random() * 8999);
        return `${p1}${p2}${num}`;
      }

      function getUrlLoginParam() {
        try {
          const params = new URLSearchParams(window.location.search);
          const login = params.get('login');
          if (login && /^[a-zA-Z0-9._-]{3,32}$/.test(login.trim())) {
            return login.trim().toLowerCase();
          }
        } catch (e) {}
        return '';
      }

      function copyToClipboard(text, successMsg = 'Skopiowano do schowka!') {
        let ok = false;
        try {
          const ta = document.createElement('textarea');
          ta.value = text;
          ta.setAttribute('readonly', '');
          ta.style.position = 'fixed';
          ta.style.left = '-9999px';
          document.body.appendChild(ta);
          ta.select();
          ta.setSelectionRange(0, 99999);
          ok = document.execCommand('copy');
          document.body.removeChild(ta);
        } catch (e) {
          ok = false;
        }

        if (ok) {
          showToast(successMsg, 'success');
          return true;
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard
            .writeText(text)
            .then(() => showToast(successMsg, 'success'))
            .catch(() => showToast('Zaznacz tekst i skopiuj ręcznie (Ctrl+C).', 'warning'));
          return true;
        }

        showToast('Zaznacz tekst i skopiuj ręcznie (Ctrl+C).', 'warning');
        return false;
      }

      function showToast(message, type = 'info') {
        const key = `${type}:${message}`;
        if (state.activeToasts.has(key)) return;
        state.activeToasts.add(key);

        const toast = document.createElement('div');
        toast.className = `toast toast-${type}`;
        toast.textContent = message;
        dom.toastContainer.appendChild(toast);

        setTimeout(() => {
          toast.style.transition = 'opacity 0.25s ease, transform 0.25s ease';
          toast.style.opacity = '0';
          toast.style.transform = 'translateY(8px)';
          setTimeout(() => {
            toast.remove();
            state.activeToasts.delete(key);
          }, 260);
        }, 3200);
      }

      function formatDuration(sec) {
        const safe = Math.max(0, Math.floor(sec));
        const m = Math.floor(safe / 60);
        const s = safe % 60;
        return `${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
      }

      function formatDateShort(isoOrDate) {
        if (!isoOrDate) return '--:--';
        const d = new Date(isoOrDate);
        if (isNaN(d.getTime())) return String(isoOrDate);
        const now = new Date();
        const sameDay = d.toDateString() === now.toDateString();
        if (sameDay) {
          return d.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
        }
        return d.toLocaleDateString('pl-PL', { day: '2-digit', month: '2-digit' }) + ' ' +
          d.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
      }

      function formatDateFull(isoOrDate) {
        if (!isoOrDate) return '';
        const d = new Date(isoOrDate);
        if (isNaN(d.getTime())) return String(isoOrDate);
        return d.toLocaleString('pl-PL', {
          day: '2-digit',
          month: '2-digit',
          year: 'numeric',
          hour: '2-digit',
          minute: '2-digit',
        });
      }

      function stripHtmlTags(html = '') {
        const div = document.createElement('div');
        div.innerHTML = html;
        return (div.textContent || div.innerText || '').trim();
      }

      /** Wykrywanie kodów weryfikacyjnych OTP (4–8 cyfr) */
      function extractOtpCode(subject = '', text = '') {
        const combined = `${subject}\n${text}`;
        if (!combined.trim()) return null;

        const kwRegex = /(?:kod(?:em|u)?|weryfikacyjn\w*|otp|pin|token|code|verification|passcode|hasło\s+jednorazowe)[^0-9a-zA-Z]{0,20}(\d{3}\s\d{3}|\d{4,8})\b/i;
        const kwMatch = combined.match(kwRegex);
        if (kwMatch && kwMatch[1]) {
          return kwMatch[1].replace(/\s+/g, '');
        }

        const spacedSix = combined.match(/\b(\d{3}\s\d{3})\b/);
        if (spacedSix) return spacedSix[1].replace(/\s+/g, '');

        const generic = combined.match(/\b(\d{4,8})\b/g);
        if (generic) {
          for (const candidate of generic) {
            const n = Number(candidate);
            if (candidate.length === 4 && n >= 1990 && n <= 2035) continue;
            return candidate;
          }
        }
        return null;
      }

      function getAvatarColor(seed = '') {
        const palette = ['#6366f1', '#7c3aed', '#0891b2', '#059669', '#2563eb', '#c026d3', '#d97706'];
        let hash = 0;
        for (let i = 0; i < seed.length; i++) {
          hash = seed.charCodeAt(i) + ((hash << 5) - hash);
        }
        return palette[Math.abs(hash) % palette.length];
      }

      function getInitials(str = '') {
        const clean = str.replace(/<.*?>/g, '').replace(/"/g, '').trim();
        const parts = clean.split(/[\s.@_-]+/).filter(Boolean);
        if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
        return (clean.slice(0, 2) || '?').toUpperCase();
      }

      // ==========================================
      // 4. ZAPIS I ODCZYT SESJI (LOCALSTORAGE)
      // ==========================================
      function saveSession() {
        if (state.mode !== 'live' || !state.session) return;
        try {
          localStorage.setItem(STORAGE_SESSION_KEY, JSON.stringify(state.session));
        } catch (e) {}
      }

      function loadSession() {
        try {
          const raw = localStorage.getItem(STORAGE_SESSION_KEY);
          if (!raw) return null;
          const parsed = JSON.parse(raw);
          if (parsed && parsed.login) {
            return {
              login: String(parsed.login).toLowerCase(),
              domain: LIVE_DOMAIN,
              startedAt: parsed.startedAt || Date.now(),
            };
          }
        } catch (e) {}
        return null;
      }

      function clearSession() {
        try {
          localStorage.removeItem(STORAGE_SESSION_KEY);
        } catch (e) {}
      }

      // ==========================================
      // 5. ZARZĄDZANIE TRYBEM NA ŻYWO I DEMO
      // ==========================================
      function setNetworkError(errMsg) {
        if (errMsg) {
          dom.networkErrorText.textContent = errMsg;
          dom.networkErrorBanner.classList.remove('hidden');
          dom.statusPill.className = 'status-pill is-error';
          dom.statusPillText.textContent = 'Błąd połączenia z API — sprawdź sieć lub użyj trybu Demo';
        } else {
          dom.networkErrorBanner.classList.add('hidden');
          updateStatusUI();
        }
      }

      function updateStatusUI() {
        const isLive = state.mode === 'live';
        dom.modeLiveBtn.className = isLive ? 'mode-btn active-live' : 'mode-btn';
        dom.modeDemoBtn.className = !isLive ? 'mode-btn active-demo' : 'mode-btn';
        dom.sendDemoEmailBtn.classList.toggle('hidden', isLive);

        if (isLive) {
          dom.statusPill.className = 'status-pill';
          dom.statusPillText.innerHTML = `Tryb Na Żywo (Maildrop.cc) • Odświeżanie za <strong class="mono">${state.refreshCountdown}</strong>s`;
        } else {
          dom.statusPill.className = 'status-pill is-demo';
          dom.statusPillText.textContent = 'Tryb Demo (Symulacja offline) • Kliknij „Wyślij testowy e-mail”';
        }
      }

      function setBusy(flag, placeholder = '') {
        state.isBusy = flag;
        if (flag && placeholder) dom.emailInput.value = placeholder;
        dom.newRandomBtn.disabled = flag;
        dom.deleteMailboxBtn.disabled = flag;
        dom.changeAddressBtn.disabled = flag;
      }

      function normalizeMaildropList(list = [], prevReadSet = new Set()) {
        const toAddr = getDisplayEmail();
        return list.map((m) => ({
          id: String(m.id),
          from: m.headerfrom || 'Nieznany nadawca',
          to: toAddr,
          subject: m.subject || '(Brak tematu)',
          date: m.date || new Date().toISOString(),
          read: prevReadSet.has(String(m.id)),
        }));
      }

      async function initLiveMode(forceNew = false, forcedLogin = '') {
        state.mode = 'live';
        setNetworkError('');
        updateStatusUI();
        setBusy(true, 'Łączenie z Maildrop.cc...');

        try {
          const urlLogin = getUrlLoginParam();
          let session = (!forceNew && !forcedLogin) ? loadSession() : null;

          if (forcedLogin) {
            session = { login: forcedLogin.toLowerCase(), domain: LIVE_DOMAIN, startedAt: Date.now() };
          } else if (urlLogin && (!session || session.login !== urlLogin)) {
            session = { login: urlLogin, domain: LIVE_DOMAIN, startedAt: Date.now() };
          } else if (!session) {
            session = { login: generateRandomLogin(), domain: LIVE_DOMAIN, startedAt: Date.now() };
          }

          state.session = session;
          saveSession();
          dom.emailInput.value = getDisplayEmail();
          state.selectedMessageId = null;
          state.messageDetailsCache = {};
          state.refreshCountdown = REFRESH_INTERVAL_SEC;

          const inboxList = await api.getInbox(state.session.login);
          state.messages = normalizeMaildropList(inboxList);

          setBusy(false);
          updateStatusUI();
          renderInbox();
        } catch (err) {
          setBusy(false);
          const msg = err && err.message ? err.message : 'Nieznany błąd sieciowy';
          setNetworkError(msg);
          dom.emailInput.value = state.session ? getDisplayEmail() : 'Brak połączenia';
          showToast(`Błąd API: ${msg}`, 'error');
        }
      }

      function initDemoMode(customLogin = '', customDomain = '') {
        state.mode = 'demo';
        setNetworkError('');
        const login = customLogin || getUrlLoginParam() || generateRandomLogin();
        const domain = customDomain && DEMO_DOMAINS.includes(customDomain) ? customDomain : DEMO_DOMAINS[0];

        state.session = { login, domain, startedAt: Date.now() };
        dom.emailInput.value = getDisplayEmail();
        state.messages = [];
        state.messageDetailsCache = {};
        state.selectedMessageId = null;

        updateStatusUI();
        addDemoMessage('welcome', true);
        addDemoMessage('otp', true);
        renderInbox();
      }

      async function refreshMessages(manual = false) {
        if (state.isBusy) return;

        dom.refreshIcon.classList.remove('spin-once');
        void dom.refreshIcon.offsetWidth;
        dom.refreshIcon.classList.add('spin-once');

        state.refreshCountdown = REFRESH_INTERVAL_SEC;
        updateRefreshProgress();

        if (state.mode === 'demo') {
          if (manual) showToast('Tryb Demo: użyj przycisku „Wyślij testowy e-mail”.', 'info');
          return;
        }

        if (!state.session || !state.session.login) {
          if (manual) initLiveMode(false);
          return;
        }

        try {
          const prevIds = new Set(state.messages.map((m) => m.id));
          const readIds = new Set(state.messages.filter((m) => m.read).map((m) => m.id));

          const inboxList = await api.getInbox(state.session.login);
          const normalized = normalizeMaildropList(inboxList, readIds);

          state.messages = normalized;
          setNetworkError('');
          renderInbox();

          const newMsgs = normalized.filter((m) => !prevIds.has(m.id));
          if (newMsgs.length > 0) {
            showToast(`Nowa wiadomość od: ${newMsgs[0].from}`, 'success');
          } else if (manual) {
            showToast('Skrzynka odświeżona — brak nowych wiadomości.', 'info');
          }
        } catch (err) {
          const msg = err && err.message ? err.message : 'Błąd połączenia';
          setNetworkError(msg);
          if (manual) showToast(`Nie udało się odświeżyć: ${msg}`, 'error');
        }
      }

      async function selectMessage(id) {
        const msg = state.messages.find((m) => m.id === id);
        if (!msg) return;

        msg.read = true;
        state.selectedMessageId = id;
        renderInbox();

        if (!state.messageDetailsCache[id] && state.mode === 'live') {
          renderDetailLoading();
          try {
            const full = await api.getMessage(state.session.login, id);
            const htmlBody = (full && full.html) ? full.html : '';
            const rawData = (full && full.data) ? full.data : '';
            const textBody = htmlBody ? stripHtmlTags(htmlBody) : rawData;

            state.messageDetailsCache[id] = {
              ...msg,
              from: (full && full.headerfrom) || msg.from,
              subject: (full && full.subject) || msg.subject,
              date: (full && full.date) || msg.date,
              html: htmlBody,
              text: textBody || 'Brak treści wiadomości.',
              rawData,
            };
          } catch (err) {
            showToast(`Błąd pobierania treści: ${err.message}`, 'error');
            state.messageDetailsCache[id] = {
              ...msg,
              html: '',
              text: 'Nie udało się załadować treści wiadomości.',
              rawData: '',
            };
          }
          renderMessageDetail();
        }
      }

      async function deleteSingleMessage(id) {
        if (state.mode === 'live' && state.session) {
          try {
            await api.deleteMessage(state.session.login, id);
          } catch (err) {
            showToast(`Nie udało się usunąć z serwera: ${err.message}`, 'warning');
          }
        }

        state.messages = state.messages.filter((m) => m.id !== id);
        delete state.messageDetailsCache[id];
        if (state.selectedMessageId === id) state.selectedMessageId = null;
        renderInbox();
        showToast('Usunięto wiadomość.', 'info');
      }

      async function generateNewMailbox(clearExistingMessages = false) {
        if (state.isBusy) return;

        if (state.mode === 'live') {
          setBusy(true, 'Tworzenie nowej skrzynki...');
          if (clearExistingMessages && state.session && state.messages.length > 0) {
            await Promise.allSettled(
              state.messages.map((m) => api.deleteMessage(state.session.login, m.id))
            );
          }
          clearSession();
          await initLiveMode(true);
          if (state.session) {
            showToast(`Nowy adres: ${getDisplayEmail()}`, 'success');
          }
        } else {
          initDemoMode();
          showToast('Wygenerowano nowy adres Demo.', 'success');
        }
      }

