      // ==========================================
      // 7. RENDEROWANIE SKRZYNKI I PODGLĄDU
      // ==========================================
      function getFilteredMessages() {
        const q = state.searchQuery.trim().toLowerCase();
        if (!q) return state.messages;
        return state.messages.filter((m) => {
          const cached = state.messageDetailsCache[m.id];
          const pool = `${m.from} ${m.subject} ${cached ? cached.text : ''}`.toLowerCase();
          return pool.includes(q);
        });
      }

      function updateUnreadBadge() {
        const total = state.messages.length;
        const unread = state.messages.filter((m) => !m.read).length;
        if (unread > 0) {
          const word = unread === 1 ? 'nowa' : unread < 5 ? 'nowe' : 'nowych';
          dom.unreadBadge.textContent = `${unread} ${word} (${total})`;
          dom.unreadBadge.className = 'badge';
        } else {
          const word = total === 1 ? 'wiadomość' : 'wiadomości';
          dom.unreadBadge.textContent = `${total} ${word}`;
          dom.unreadBadge.className = 'badge badge-muted';
        }
      }

      function renderInbox() {
        updateUnreadBadge();
        const filtered = getFilteredMessages();

        if (filtered.length === 0) {
          const searching = state.searchQuery.trim().length > 0;
          const title = searching
            ? 'Brak pasujących wiadomości'
            : state.mode === 'live'
            ? 'Oczekiwanie na wiadomości...'
            : 'Skrzynka Demo jest pusta';
          const desc = searching
            ? 'Zmień frazę w wyszukiwarce, aby zobaczyć pozostałe wiadomości.'
            : state.mode === 'live'
            ? 'Wyślij e-mail na powyższy adres — pojawi się tutaj automatycznie w ciągu kilku sekund.'
            : 'Kliknij przycisk „Wyślij testowy e-mail”, aby zasymulować nową wiadomość.';

          dom.messageListPane.innerHTML = `
            <div class="empty-state">
              <div class="empty-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <strong>${escapeHtml(title)}</strong>
              <p>${escapeHtml(desc)}</p>
            </div>
          `;
        } else {
          dom.messageListPane.innerHTML = filtered
            .map((msg) => {
              const selected = msg.id === state.selectedMessageId;
              const initials = getInitials(msg.from);
              const color = getAvatarColor(msg.from);
              const quickOtp = extractOtpCode(msg.subject, '');

              return `
                <div class="msg-item ${selected ? 'selected' : ''}" data-msg-id="${escapeHtml(msg.id)}">
                  <div class="avatar" style="background: ${color};">
                    ${escapeHtml(initials)}
                    ${!msg.read ? '<span class="unread-dot" title="Nieprzeczytana"></span>' : ''}
                  </div>
                  <div class="msg-meta">
                    <div class="msg-top">
                      <span class="msg-sender ${!msg.read ? 'unread' : ''}">${escapeHtml(msg.from)}</span>
                      <span class="msg-time">${escapeHtml(formatDateShort(msg.date))}</span>
                    </div>
                    <p class="msg-subject ${!msg.read ? 'unread' : ''}">${escapeHtml(msg.subject)}</p>
                    <div class="msg-preview-row">
                      ${quickOtp ? `<span class="otp-chip">OTP: ${escapeHtml(quickOtp)}</span>` : ''}
                      <p class="msg-excerpt">Kliknij, aby otworzyć wiadomość...</p>
                    </div>
                  </div>
                  <button type="button" class="msg-del-btn" data-delete-id="${escapeHtml(msg.id)}" title="Usuń wiadomość" aria-label="Usuń wiadomość">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                  </button>
                </div>
              `;
            })
            .join('');
        }

        renderMessageDetail();
      }

      function renderDetailLoading() {
        dom.messageListPane.classList.add('mobile-hidden');
        dom.messageDetailPane.classList.add('mobile-visible');
        dom.messageDetailPane.innerHTML = `
          <div class="empty-state">
            <svg class="spin-loop" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" style="color: var(--accent-violet)">
              <path stroke-linecap="round" d="M12 3a9 9 0 1 0 9 9" />
            </svg>
            <p>Pobieranie pełnej treści wiadomości...</p>
          </div>
        `;
      }

      function renderMessageDetail() {
        const msg = state.messages.find((m) => m.id === state.selectedMessageId);
        if (!msg) {
          dom.messageListPane.classList.remove('mobile-hidden');
          dom.messageDetailPane.classList.remove('mobile-visible');
          dom.messageDetailPane.innerHTML = `
            <div class="empty-state">
              <div class="empty-icon">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5" />
                </svg>
              </div>
              <p>Wybierz wiadomość z listy, aby wyświetlić jej pełną treść.</p>
            </div>
          `;
          return;
        }

        const detail = state.messageDetailsCache[msg.id] || { ...msg, html: '', text: '' };
        const hasHtml = Boolean(detail.html && detail.html.trim().length > 0);
        const viewMode = hasHtml ? state.detailViewMode : 'text';
        const detectedOtp = extractOtpCode(detail.subject, `${detail.text || ''}\n${stripHtmlTags(detail.html || '')}`);

        dom.messageListPane.classList.add('mobile-hidden');
        dom.messageDetailPane.classList.add('mobile-visible');

        const initials = getInitials(detail.from);
        const color = getAvatarColor(detail.from);

        dom.messageDetailPane.innerHTML = `
          <div class="detail-toolbar">
            <button type="button" id="backToListBtn" class="btn btn-sm back-mobile-btn">← Wróć</button>

            <div class="view-toggle">
              <button type="button" data-view-mode="html" class="${viewMode === 'html' ? 'active' : ''}" ${!hasHtml ? 'disabled' : ''}>HTML</button>
              <button type="button" data-view-mode="text" class="${viewMode === 'text' ? 'active' : ''}">Tekst</button>
            </div>

            <div style="display: flex; gap: 6px; margin-left: auto;">
              <button type="button" id="downloadEmlBtn" class="btn btn-sm">Pobierz .eml</button>
              <button type="button" id="deleteDetailMsgBtn" class="btn btn-sm btn-danger">Usuń</button>
            </div>
          </div>

          ${
            detectedOtp
              ? `
                <div class="otp-banner">
                  <div class="otp-info">
                    <div class="otp-icon">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                      </svg>
                    </div>
                    <div>
                      <div class="otp-label">Wykryto kod weryfikacyjny</div>
                      <div class="otp-code">${escapeHtml(detectedOtp)}</div>
                    </div>
                  </div>
                  <button type="button" class="btn btn-sm btn-emerald" data-copy-otp="${escapeHtml(detectedOtp)}">Kopiuj kod</button>
                </div>
              `
              : ''
          }

          <div class="detail-header">
            <h3 class="detail-subject">${escapeHtml(detail.subject)}</h3>
            <div class="detail-sender-row">
              <div class="avatar" style="background: ${color};">${escapeHtml(initials)}</div>
              <div style="min-width: 0; flex: 1;">
                <div style="color: var(--text-main); font-weight: 600; word-break: break-all;">${escapeHtml(detail.from)}</div>
                <div>Do: <span class="mono">${escapeHtml(detail.to || getDisplayEmail())}</span></div>
                <div>${escapeHtml(formatDateFull(detail.date))}</div>
              </div>
            </div>
          </div>

          <div class="detail-body">
            ${
              viewMode === 'html'
                ? `<iframe id="emailHtmlFrame" class="email-iframe" title="Podgląd wiadomości HTML" sandbox="allow-popups allow-popups-to-escape-sandbox"></iframe>`
                : `<pre class="email-text-body">${escapeHtml(detail.text || 'Brak treści tekstowej.')}</pre>`
            }
          </div>
        `;

        if (viewMode === 'html') {
          const iframe = document.getElementById('emailHtmlFrame');
          if (iframe) {
            iframe.srcdoc = `<!DOCTYPE html><html><head><meta charset="UTF-8"><base target="_blank"><style>body{margin:0;padding:18px;font-family:Inter,system-ui,-apple-system,sans-serif;color:#0f172a;background:#ffffff;line-height:1.6;word-wrap:break-word;}img{max-width:100%;height:auto;}</style></head><body>${detail.html}</body></html>`;
          }
        }
      }

      function downloadCurrentEml() {
        const msg = state.messages.find((m) => m.id === state.selectedMessageId);
        if (!msg) return;
        const detail = state.messageDetailsCache[msg.id] || msg;

        const eml = detail.rawData
          ? detail.rawData
          : [
              `From: ${detail.from}`,
              `To: ${detail.to || getDisplayEmail()}`,
              `Subject: ${detail.subject}`,
              `Date: ${detail.date || new Date().toUTCString()}`,
              `MIME-Version: 1.0`,
              `Content-Type: text/plain; charset=UTF-8`,
              ``,
              detail.text || '',
            ].join('\r\n');

        const blob = new Blob([eml], { type: 'message/rfc822;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        const safeName = (detail.subject || 'wiadomosc').replace(/[^a-zA-Z0-9_-]+/g, '_').slice(0, 32);
        a.href = url;
        a.download = `${safeName}.eml`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        showToast('Pobrano plik .eml', 'success');
      }

      // ==========================================
      // 8. MODALE, KOD QR I LICZNIKI
      // ==========================================
      function openModal(el) { el.classList.remove('hidden'); }
      function closeModal(el) { el.classList.add('hidden'); }

      function openChangeAddressModal() {
        const current = getDisplayEmail();
        const [userPart, domainPart] = current.split('@');
        dom.customUsernameInput.value = userPart || generateRandomLogin();

        const list = state.mode === 'live' ? [LIVE_DOMAIN] : DEMO_DOMAINS;
        dom.domainSelect.innerHTML = list.map((d) => `<option value="${escapeHtml(d)}">@${escapeHtml(d)}</option>`).join('');
        dom.domainSelect.disabled = state.mode === 'live';
        if (domainPart && list.includes(domainPart)) {
          dom.domainSelect.value = domainPart;
        }
        openModal(dom.changeAddressModal);
        setTimeout(() => dom.customUsernameInput.focus(), 40);
      }

      function openQrModal() {
        const email = getDisplayEmail();
        if (!email) return;
        dom.qrEmailLabel.textContent = email;
        dom.qrImage.src = `https://api.qrserver.com/v1/create-qr-code/?size=192x192&margin=4&data=${encodeURIComponent('mailto:' + email)}`;
        openModal(dom.qrModal);
      }

      function updateRefreshProgress() {
        const pct = Math.max(0, Math.min(100, (state.refreshCountdown / REFRESH_INTERVAL_SEC) * 100));
        dom.refreshProgressBar.style.width = `${pct}%`;
        if (dom.networkErrorBanner.classList.contains('hidden')) {
          updateStatusUI();
        }
      }

      function startIntervals() {
        setInterval(() => {
          if (state.session && state.session.startedAt) {
            const elapsed = Math.floor((Date.now() - state.session.startedAt) / 1000);
            dom.sessionTimer.textContent = formatDuration(elapsed);
          }

          if (state.mode === 'live' && !state.isBusy && state.session && state.session.login) {
            state.refreshCountdown--;
            if (state.refreshCountdown <= 0) {
              refreshMessages(false);
            } else {
              updateRefreshProgress();
            }
          }
        }, 1000);
      }

      // ==========================================
      // 9. MOTYW JASNY / CIEMNY
      // ==========================================
      function syncThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        dom.iconSun.classList.toggle('hidden', !isDark);
        dom.iconMoon.classList.toggle('hidden', isDark);
      }

      function initTheme() {
        let saved = null;
        try { saved = localStorage.getItem(STORAGE_THEME_KEY); } catch (e) {}
        const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (saved === 'dark' || (!saved && prefersDark)) {
          document.documentElement.classList.add('dark');
        }
        syncThemeIcons();
      }

      function toggleTheme() {
        const isDark = document.documentElement.classList.toggle('dark');
        try { localStorage.setItem(STORAGE_THEME_KEY, isDark ? 'dark' : 'light'); } catch (e) {}
        syncThemeIcons();
      }

      // ==========================================
      // 10. ZDARZENIA I START
      // ==========================================
      function bindEvents() {
        dom.themeToggleBtn.addEventListener('click', toggleTheme);

        dom.modeLiveBtn.addEventListener('click', () => {
          if (state.mode === 'live' && !dom.networkErrorBanner.classList.contains('hidden')) {
            initLiveMode(false);
            return;
          }
          if (state.mode !== 'live') initLiveMode(false);
        });

        dom.modeDemoBtn.addEventListener('click', () => {
          if (state.mode !== 'demo') {
            initDemoMode();
            showToast('Przełączono w tryb Demo (offline).', 'info');
          }
        });

        dom.retryLiveBtn.addEventListener('click', () => initLiveMode(false));
        dom.switchToDemoFromErrorBtn.addEventListener('click', () => {
          initDemoMode();
          showToast('Przełączono w tryb Demo (offline).', 'info');
        });

        dom.copyEmailBtn.addEventListener('click', () => {
          const email = getDisplayEmail();
          if (!email) return;
          copyToClipboard(email, 'Skopiowano adres e-mail!');
          dom.copyBtnText.textContent = 'Skopiowano!';
          dom.copyBtnIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />';
          setTimeout(() => {
            dom.copyBtnText.textContent = 'Kopiuj';
            dom.copyBtnIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />';
          }, 1800);
        });

        dom.refreshBtn.addEventListener('click', () => refreshMessages(true));
        dom.changeAddressBtn.addEventListener('click', openChangeAddressModal);
        dom.qrCodeBtn.addEventListener('click', openQrModal);
        dom.newRandomBtn.addEventListener('click', () => generateNewMailbox(false));
        dom.deleteMailboxBtn.addEventListener('click', () => generateNewMailbox(true));

        dom.resetSessionTimerBtn.addEventListener('click', () => {
          if (state.session) {
            state.session.startedAt = Date.now();
            saveSession();
          }
          dom.sessionTimer.textContent = '00:00';
          showToast('Zresetowano licznik sesji.', 'info');
        });

        dom.searchInput.addEventListener('input', (e) => {
          state.searchQuery = e.target.value;
          renderInbox();
        });

        dom.sendDemoEmailBtn.addEventListener('click', () => addDemoMessage());

        dom.messageListPane.addEventListener('click', (e) => {
          const delBtn = e.target.closest('[data-delete-id]');
          if (delBtn) {
            e.stopPropagation();
            deleteSingleMessage(delBtn.getAttribute('data-delete-id'));
            return;
          }
          const item = e.target.closest('.msg-item');
          if (item) selectMessage(item.getAttribute('data-msg-id'));
        });

        dom.messageDetailPane.addEventListener('click', (e) => {
          if (e.target.closest('#backToListBtn')) {
            state.selectedMessageId = null;
            renderInbox();
            return;
          }
          const viewBtn = e.target.closest('[data-view-mode]');
          if (viewBtn && !viewBtn.disabled) {
            state.detailViewMode = viewBtn.getAttribute('data-view-mode');
            renderMessageDetail();
            return;
          }
          const otpBtn = e.target.closest('[data-copy-otp]');
          if (otpBtn) {
            const code = otpBtn.getAttribute('data-copy-otp');
            copyToClipboard(code, `Skopiowano kod OTP: ${code}`);
            return;
          }
          if (e.target.closest('#downloadEmlBtn')) {
            downloadCurrentEml();
            return;
          }
          if (e.target.closest('#deleteDetailMsgBtn') && state.selectedMessageId) {
            deleteSingleMessage(state.selectedMessageId);
          }
        });

        dom.randomizeUsernameBtn.addEventListener('click', () => {
          dom.customUsernameInput.value = generateRandomLogin();
        });

        dom.changeAddressForm.addEventListener('submit', async (e) => {
          e.preventDefault();
          const login = dom.customUsernameInput.value.trim().toLowerCase();
          const domain = dom.domainSelect.value;

          if (!/^[a-z0-9._-]{3,32}$/.test(login)) {
            showToast('Login musi mieć 3–32 znaki (litery, cyfry, _ -).', 'error');
            return;
          }

          closeModal(dom.changeAddressModal);

          if (state.mode === 'live') {
            await initLiveMode(false, login);
            showToast(`Ustawiono adres: ${getDisplayEmail()}`, 'success');
          } else {
            initDemoMode(login, domain);
            showToast(`Zmieniono adres Demo na ${login}@${domain}`, 'success');
          }
        });

        document.querySelectorAll('[data-close-modal]').forEach((btn) => {
          btn.addEventListener('click', () => {
            const modal = document.getElementById(btn.getAttribute('data-close-modal'));
            if (modal) closeModal(modal);
          });
        });

        [dom.changeAddressModal, dom.qrModal].forEach((modal) => {
          modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal(modal);
          });
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            closeModal(dom.changeAddressModal);
            closeModal(dom.qrModal);
          }
        });

        document.querySelectorAll('.faq-trigger').forEach((trigger) => {
          trigger.addEventListener('click', () => {
            const content = trigger.nextElementSibling;
            const expanded = trigger.getAttribute('aria-expanded') === 'true';
            trigger.setAttribute('aria-expanded', String(!expanded));
            content.classList.toggle('hidden');
          });
        });
      }

      function init() {
        dom.currentYear.textContent = String(new Date().getFullYear());
        initTheme();
        bindEvents();
        startIntervals();
        initLiveMode(false);
      }

      init();
    })();
  </script>
</body>
</html>
