  <!-- ==================== LOGIKA APLIKACJI (MAILDROP.CC GRAPHQL CLIENT) ==================== -->
  <script>
    (function () {
      'use strict';

      const PROXY_URL = 'https://znikmail.vercel.app/api/maildrop';
      const LIVE_DOMAIN = 'maildrop.cc';
      const DEMO_DOMAINS = ['znikmail.demo', 'szybkapoczta.demo', 'chwilowka.demo'];
      const STORAGE_SESSION_KEY = 'znikmail_maildrop_session_v1';
      const STORAGE_THEME_KEY = 'znikmail_theme_v1';
      const REFRESH_INTERVAL_SEC = 6;

      // ==========================================
      // 1. KLASA KLIENTA API MAILDROP.CC (GRAPHQL)
      // ==========================================
      class MaildropClient {
        constructor(endpoint) {
          this.endpoint = endpoint;
        }

        async graphql(query, variables = {}) {
          const response = await fetch(this.endpoint, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              Accept: 'application/json',
            },
            body: JSON.stringify({ query, variables }),
          });

          if (!response.ok) {
            throw new Error(`HTTP ${response.status} ${response.statusText || ''}`.trim());
          }

          const payload = await response.json();
          if (payload.errors && payload.errors.length > 0) {
            throw new Error(payload.errors[0].message || 'Błąd zapytania GraphQL');
          }
          if (payload.error) {
            throw new Error(String(payload.error));
          }
          return payload.data;
        }

        /** Pobieranie listy wiadomości w skrzynce */
        async getInbox(mailbox) {
          const query = `query ($mailbox: String!) {
            inbox(mailbox: $mailbox) {
              id
              headerfrom
              subject
              date
            }
          }`;
          const data = await this.graphql(query, { mailbox });
          return (data && data.inbox) ? data.inbox : [];
        }

        /** Pobieranie pełnej treści pojedynczej wiadomości */
        async getMessage(mailbox, id) {
          const query = `query ($mailbox: String!, $id: String!) {
            message(mailbox: $mailbox, id: $id) {
              id
              headerfrom
              subject
              date
              html
              data
            }
          }`;
          const data = await this.graphql(query, { mailbox, id });
          return data ? data.message : null;
        }

        /** Usuwanie pojedynczej wiadomości */
        async deleteMessage(mailbox, id) {
          const query = `mutation ($mailbox: String!, $id: String!) {
            delete(mailbox: $mailbox, id: $id)
          }`;
          const data = await this.graphql(query, { mailbox, id });
          return Boolean(data && data.delete);
        }
      }

      const api = new MaildropClient(PROXY_URL);

      // ==========================================
      // 2. STAN APLIKACJI I REFERENCJE DOM
      // ==========================================
      const state = {
        mode: 'live', // 'live' | 'demo'
        session: null, // { login, domain, startedAt }
        messages: [],
        messageDetailsCache: {},
        selectedMessageId: null,
        detailViewMode: 'html', // 'html' | 'text'
        searchQuery: '',
